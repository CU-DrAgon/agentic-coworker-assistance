# Copy to .env and fill in. .env is git-ignored; never commit real values.
DISCORD_WEBHOOK_URL=
# Optional overrides (defaults in src/meeting_scribe/config.py)
# GCP_PROJECT=meeting-scribe-hackathon
# AUDIO_BUCKET=meeting-scribe-hackathon-audio
# USE_PUBSUB=false
# STORE=memory

# Salid (Discord receipts + expense Q&A bot). All keys are SALID_-prefixed.
SALID_DISCORD_TOKEN=
# Voice helper bots "Salid · 2", "Salid · 3" (comma-separated tokens; see README "Voice helpers").
# Put the tokens here with an editor; never paste them in chat or logs.
# SALID_VOICE_TOKENS=
# SALID_AUTO_JOIN_MIN_HUMANS=1   # join a voice channel once this many people are in it
# SALID_AUTO_JOIN_DELAY_SECONDS=0   # optional stability wait before auto-joining (0 = immediately)
# SALID_AUTO_JOIN_COOLDOWN_MINUTES=60   # no auto-join in a channel where someone told Salid to leave
# Local defaults applied to every guild; customers normally need none of these (channels named
# "ใบเสร็จ"/"receipt" work out of the box, the rest is set per guild in /hub).
# SALID_RECEIPT_CHANNEL_IDS=    # comma-separated channel ids
# SALID_ASK_CHANNEL_IDS=        # channels where every message is a question
# SALID_EXEC_ROLE_NAMES=ผู้บริหาร,Executive
# SALID_EXEC_USER_IDS=          # comma-separated user ids
# SALID_DIGEST_TIME=18:00       # HH:MM in SALID_TZ
# SALID_DIGEST_CHANNEL_ID=
# SALID_HUB_URL=https://meeting-scribe-638191001920.asia-southeast1.run.app   # target of /ตั้งค่า links
# SALID_DB_PATH=./data/ledger.db
# SALID_GCP_PROJECT=meeting-scribe-hackathon
# SALID_GEMINI_LOCATION=global
# SALID_GEMINI_MODEL=gemini-3.5-flash
# SALID_TZ=Asia/Bangkok
# SALID_STORE=
# SALID_FIRESTORE_COLLECTION=
# SALID_RECEIPT_BUCKET=
# SALID_GEMINI_CLI_PATH=
# SALID_DEEP_TASK_TIMEOUT=
# SALID_DEEP_TASK_MODEL=
# SALID_GATE_MODEL=gemini-3.5-flash-lite   # cheap yes/no gate for call/join modes; also memory summaries and image descriptions
# Team memory (see README): default retention for guilds that did not set one, summary triggers, import caps
# SALID_MEMORY_RETENTION_DAYS=90
# SALID_MEMORY_UPDATE_EVERY=30
# SALID_MEMORY_QUIET_MINUTES=20
# SALID_MEMORY_IMPORT_GUILD_CAP=20000
# SALID_MEMORY_IMPORT_IMAGES_PER_DAY=300
# SALID_MEMORY_IMPORT_SUMMARIES_PER_DAY=200
# Meaning-based memory search (embeddings of summary items). Empty model = keyword-only search.
# SALID_EMBED_MODEL=gemini-embedding-001
# SALID_EMBED_DIM=256
# SALID_EMBED_LOCATION=         # empty = SALID_GEMINI_LOCATION

# Salid command center (/hub). Empty client id = every /api/hub call returns 503.
# HUB_GOOGLE_CLIENT_ID=         # OAuth 2.0 Web client id (public). Authorized origins: Cloud Run URL, http://localhost:8080
# HUB_ADMIN_EMAILS=             # optional super admins (comma-separated Google accounts) who see every guild
# SALID_DISCORD_CLIENT_ID=      # public Discord application id; builds the Add-to-Discord link
# SALID_GUILD_COLLECTION=salid_guilds   # Firestore: one settings doc per guild (hub and bot must match)

# Flights (optional): without a key flight_status uses a Google Search grounded lookup and track_flight is off
# SALID_AERODATABOX_KEY=        # RapidAPI key for AeroDataBox
# SALID_AVIATIONSTACK_KEY=

# Salid on Slack, LINE and Telegram (separate process: python -m salid.platforms). Each platform starts only
# when all of its secrets are set. See docs/platforms/.
# SALID_SLACK_BOT_TOKEN=xoxb-...        # secret
# SALID_SLACK_APP_TOKEN=xapp-...        # secret (Socket Mode, scope connections:write)
# SALID_SLACK_EXEC_USER_IDS=U0123,U0456 # extra executives; workspace owners/admins always count
# SALID_SLACK_IMPORT=true               # import channel history within the retention window
# SALID_LINE_CHANNEL_SECRET=            # secret
# SALID_LINE_CHANNEL_ACCESS_TOKEN=      # secret
# SALID_LINE_EXEC_USER_IDS=U...         # LINE user ids of executives
# SALID_LINE_HOST=127.0.0.1             # 0.0.0.0 in a container
# SALID_LINE_PORT=8091
# SALID_TELEGRAM_BOT_TOKEN=123456:ABC...  # secret (from @BotFather; long polling, no public URL)
# SALID_TELEGRAM_EXEC_USER_IDS=123456789 # numeric Telegram user ids of executives (group admins do not count)

